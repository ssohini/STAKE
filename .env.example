# ==============================================================================
# PayPal REST API v2 (Sandbox ONLY — never use live credentials for hackathon)
# Create a Sandbox app in the PayPal Developer Dashboard:
# https://developer.paypal.com/dashboard/applications/sandbox
# ==============================================================================

# Server-side PayPal Sandbox REST App Client ID (REQUIRED)
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Server-side PayPal Sandbox REST App Client Secret (REQUIRED, server-only)
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret

# PayPal Sandbox API base URL (REQUIRED; must remain Sandbox)
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Client-side PayPal JS SDK Client ID (REQUIRED; usually identical to PAYPAL_CLIENT_ID)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id

# Webhook ID generated after registering POST /api/paypal/webhook in PayPal Dashboard
# Subscribe to: PAYMENT.AUTHORIZATION.CREATED, PAYMENT.CAPTURE.COMPLETED, PAYMENT.AUTHORIZATION.VOIDED
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id

# ==============================================================================
# Vision AI Judge (Google Gemini)
# Get an API key from Google AI Studio: https://aistudio.google.com/apikey
# ==============================================================================

# Gemini API key used server-side by Coach Razor (REQUIRED; model never touches PayPal)
GEMINI_API_KEY=your_gemini_api_key

# Optional override for the Gemini vision model (defaults to gemini-2.5-flash)
# GEMINI_MODEL=gemini-3.6-flash

# ==============================================================================
# Storage (REQUIRED on Vercel / serverless deployment; optional locally)
# Leave unset locally to use JSON file storage (.data/contracts.json).
# When both UPSTASH_* variables are set, Stake automatically uses Upstash Redis.
# ==============================================================================

# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# ==============================================================================
# Cron Security (Optional — recommended on Vercel)
# Vercel Cron sends Authorization: Bearer <CRON_SECRET> on GET /api/cron/resolve
# ==============================================================================

# CRON_SECRET=your_random_cron_secret
